# Contact form → n8n → Outreach CRM
# Both are server-only. Never prefix them with NEXT_PUBLIC_.

# Production webhook URL of the "DAMASAVERO – Website Contact Lead Intake" workflow.
N8N_CONTACT_WEBHOOK_URL=

# Shared secret sent as the x-damasavero-signature header. The n8n workflow
# rejects any request whose header does not match. Optional but recommended.
N8N_CONTACT_WEBHOOK_SECRET=

# Instant lead alert to Telegram (optional, free). Server-only as well.
# Token from @BotFather; chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
# after you send your bot any message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
